{
	"name": "n8n-nodes-pipelex",
	"version": "0.0.9",
	"description": "Pipelex n8n node package",
	"license": "MIT",
	"keywords": [
		"n8n-community-node-package"
	],
	"author": {
		"name": "Evotis S.A.S.",
		"email": "oss@pipelex.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/Pipelex/n8n-nodes-pipelex.git"
	},
	"homepage": "https://github.com/Pipelex/n8n-nodes-pipelex#readme",
	"scripts": {
		"dev": "n8n-node dev",
		"build": "n8n-node build",
		"lint": "eslint .",
		"lint:ts": "eslint --config eslint.config.ts.mjs .",
		"lint:n8n": "eslint --config eslint.config.n8n.mjs .",
		"scan:simulate": "eslint --config eslint.config.scan.mjs 'dist/**/*.js' 'dist/**/*.json' 'package.json'",
		"format": "prettier --write .",
		"prepublishOnly": "pnpm run build",
		"postpublish": "sleep 10 && make check-published"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"credentials": [
			"dist/credentials/PiplexApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Pipelex/Pipelex.node.js"
		]
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@n8n/eslint-plugin-community-nodes": "^0.16.0",
		"@n8n/node-cli": "*",
		"eslint": "^9.0.0",
		"eslint-import-resolver-typescript": "^4.4.4",
		"eslint-plugin-import-x": "^4.16.2",
		"eslint-plugin-n8n-nodes-base": "^1.16.6",
		"typescript": "~5.6",
		"typescript-eslint": "^8.0.0"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"packageManager": "pnpm@10.18.1+sha512.77a884a165cbba2d8d1c19e3b4880eee6d2fcabd0d879121e282196b80042351d5eb3ca0935fa599da1dc51265cc68816ad2bddd2a2de5ea9fdf92adbec7cd34"
}
